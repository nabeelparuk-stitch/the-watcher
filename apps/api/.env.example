PORT=4000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Comma-separated origins for the Next.js app (browser)
CORS_ORIGIN=http://localhost:3000
# Or allow all origins (simplest for Vercel + Railway): CORS_ALLOW_ALL=true
# Path to apps/checkout-worker (Playwright). Optional if default layout matches.
# CHECKOUT_WORKER_DIR=../checkout-worker
# CHECKOUT_PYTHON=../checkout-worker/.venv/bin/python

# Google Sheets (optional) — append checkout report rows
# GOOGLE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# Or single-line JSON: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=
# GOOGLE_SHEETS_DEFAULT_SHEET_NAME=Results
